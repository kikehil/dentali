<%- include('../layout', { body: `
<div class="max-w-4xl mx-auto">
  <div class="bg-white rounded-xl shadow-lg p-6 mb-6">
    <div class="flex justify-end items-center mb-6">
      <div class="flex gap-2">
        <a href="/cortes/historial" class="text-gray-500 hover:text-gray-700">
          <i class="fas fa-arrow-left mr-2"></i>Volver
        </a>
        <a href="/cortes/${corte.id}/reporte" target="_blank" class="bg-red-500 hover:bg-red-600 text-white px-4 py-2 rounded-lg">
          <i class="fas fa-file-pdf mr-2"></i>Descargar PDF
        </a>
      </div>
    </div>

    <div class="grid md:grid-cols-2 gap-4 mb-6">
      <div class="bg-gray-50 rounded-lg p-4">
        <p class="text-sm text-gray-600 mb-1">Fecha</p>
        <p class="font-bold text-gray-800">${moment(corte.fecha).format('DD/MM/YYYY')}</p>
      </div>
      <div class="bg-gray-50 rounded-lg p-4">
        <p class="text-sm text-gray-600 mb-1">Hora</p>
        <p class="font-bold text-gray-800">${corte.hora || 'Saldo Inicial'}</p>
      </div>
      <div class="bg-gray-50 rounded-lg p-4">
        <p class="text-sm text-gray-600 mb-1">Realizado por</p>
        <p class="font-bold text-gray-800">${corte.usuario ? corte.usuario.nombre : 'N/A'}</p>
      </div>
    </div>

    <div class="mb-6">
      <h3 class="text-lg font-bold text-gray-800 mb-4">Saldos Iniciales</h3>
      <div class="grid md:grid-cols-3 gap-4">
        <div class="bg-green-50 rounded-lg p-4 border-l-4 border-green-500">
          <p class="text-sm text-gray-600 mb-1">Efectivo</p>
          <p class="text-xl font-bold text-green-600">${formatCurrency(parseFloat(corte.saldoInicialEfectivo))}</p>
        </div>
        <div class="bg-blue-50 rounded-lg p-4 border-l-4 border-blue-500">
          <p class="text-sm text-gray-600 mb-1">Tarjeta</p>
          <p class="text-xl font-bold text-blue-600">${formatCurrency(parseFloat(corte.saldoInicialTarjetaAzteca || 0) + parseFloat(corte.saldoInicialTarjetaBbva || 0) + parseFloat(corte.saldoInicialTarjetaMp || 0))}</p>
        </div>
        <div class="bg-purple-50 rounded-lg p-4 border-l-4 border-purple-500">
          <p class="text-sm text-gray-600 mb-1">Transferencia</p>
          <p class="text-xl font-bold text-purple-600">${formatCurrency(parseFloat(corte.saldoInicialTransferencia))}</p>
        </div>
      </div>
      <div class="mt-4 bg-gray-50 rounded-lg p-4">
        <p class="text-sm text-gray-600 mb-1">Total Saldo Inicial</p>
        <p class="text-2xl font-bold text-gray-800">${formatCurrency(parseFloat(corte.saldoInicial))}</p>
      </div>
    </div>

    <div class="mb-6">
      <h3 class="text-lg font-bold text-gray-800 mb-4">Ventas del Período</h3>
      <div class="grid md:grid-cols-3 gap-4 mb-4">
        <div class="bg-green-50 rounded-lg p-4">
          <p class="text-sm text-gray-600 mb-1">Efectivo</p>
          <p class="text-xl font-bold text-green-600">${formatCurrency(parseFloat(corte.ventasEfectivo))}</p>
        </div>
        <div class="bg-blue-50 rounded-lg p-4">
          <p class="text-sm text-gray-600 mb-1">Tarjeta</p>
          <p class="text-xl font-bold text-blue-600">${formatCurrency(parseFloat(corte.ventasTarjeta))}</p>
          ${parseFloat(corte.ventasTarjeta) > 0 ? 
            '<div class="mt-2 text-xs text-gray-600">' +
              '<p>Azteca: ' + formatCurrency(parseFloat(corte.ventasTarjetaAzteca || 0)) + '</p>' +
              '<p>BBVA: ' + formatCurrency(parseFloat(corte.ventasTarjetaBbva || 0)) + '</p>' +
              '<p>Mercado Pago: ' + formatCurrency(parseFloat(corte.ventasTarjetaMp || 0)) + '</p>' +
            '</div>' : ''
          }
        </div>
        <div class="bg-purple-50 rounded-lg p-4">
          <p class="text-sm text-gray-600 mb-1">Transferencia</p>
          <p class="text-xl font-bold text-purple-600">${formatCurrency(parseFloat(corte.ventasTransferencia))}</p>
        </div>
      </div>
      <div class="bg-gray-50 rounded-lg p-4">
        <p class="text-sm text-gray-600 mb-1">Total Ventas</p>
        <p class="text-2xl font-bold text-gray-800">${formatCurrency(parseFloat(corte.totalVentas))}</p>
      </div>
    </div>

    <div class="mb-6">
      <h3 class="text-lg font-bold text-gray-800 mb-4">Saldos Finales</h3>
      <div class="grid md:grid-cols-3 gap-4">
        <div class="bg-green-50 rounded-lg p-4 border-l-4 border-green-500">
          <p class="text-sm text-gray-600 mb-1">Efectivo</p>
          <p class="text-xl font-bold text-green-600">${formatCurrency(parseFloat(corte.saldoFinalEfectivo))}</p>
        </div>
        <div class="bg-blue-50 rounded-lg p-4 border-l-4 border-blue-500">
          <p class="text-sm text-gray-600 mb-1">Tarjeta</p>
          <p class="text-xl font-bold text-blue-600">${formatCurrency(parseFloat(corte.saldoFinalTarjetaAzteca || 0) + parseFloat(corte.saldoFinalTarjetaBbva || 0) + parseFloat(corte.saldoFinalTarjetaMp || 0))}</p>
        </div>
        <div class="bg-purple-50 rounded-lg p-4 border-l-4 border-purple-500">
          <p class="text-sm text-gray-600 mb-1">Transferencia</p>
          <p class="text-xl font-bold text-purple-600">${formatCurrency(parseFloat(corte.saldoFinalTransferencia))}</p>
        </div>
      </div>
      <div class="mt-4 bg-gray-50 rounded-lg p-4">
        <p class="text-sm text-gray-600 mb-1">Total Saldo Final</p>
        <p class="text-2xl font-bold text-gray-800">${formatCurrency(parseFloat(corte.saldoFinal))}</p>
      </div>
    </div>

    <div class="mb-6">
      <div class="bg-${parseFloat(corte.diferencia) < 0 ? 'red' : 'green'}-50 rounded-lg p-4 border-l-4 border-${parseFloat(corte.diferencia) < 0 ? 'red' : 'green'}-500">
        <p class="text-sm text-gray-600 mb-1">Diferencia</p>
        <p class="text-3xl font-bold text-${parseFloat(corte.diferencia) < 0 ? 'red' : 'green'}-600">
          ${formatCurrency(parseFloat(corte.diferencia))}
        </p>
      </div>
    </div>

    ${corte.observaciones ? 
      '<div class="mb-6">' +
        '<h3 class="text-lg font-bold text-gray-800 mb-2">Observaciones</h3>' +
        '<div class="bg-gray-50 rounded-lg p-4">' +
          '<p class="text-gray-700">' + corte.observaciones + '</p>' +
        '</div>' +
      '</div>' : ''
    }
  </div>
</div>
` }) %>
